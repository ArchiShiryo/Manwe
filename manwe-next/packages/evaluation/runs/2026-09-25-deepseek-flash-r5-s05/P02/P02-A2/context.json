      "id": "05bb353e-653e-49e7-9716-20a5fbff2c97",
      "text": "Hugo a annulé au dernier moment le covoiturage qu'il devait conduire et l'utilisateur a conduit à sa place.",
      "category": "sourced_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-20T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
