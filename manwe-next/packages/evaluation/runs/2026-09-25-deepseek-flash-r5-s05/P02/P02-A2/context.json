    {
      "id": "969e5f4f-3fe7-4cae-b4fe-a801d8a1ae32",
      "text": "Léa a demandé à l'utilisateur de faire les inscriptions de l'équipe au tournoi et il les a faites, comme chaque saison.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-06T20:00:00+01:00",
