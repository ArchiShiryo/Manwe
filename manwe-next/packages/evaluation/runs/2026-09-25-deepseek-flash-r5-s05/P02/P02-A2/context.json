      ]
    },
    {
      "id": "42852cff-fd2a-4775-9cc8-597e961ca375",
      "text": "L'utilisateur a avancé l'argent des nouveaux maillots et a relancé Léa et Hugo pour qu'ils le remboursent.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-09T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "1c5e5d41-5324-449e-abc0-63e78e915346"
      ]
    },
    {
      "id": "5635b04d-54ba-4aa9-af30-bfb09cc7d9a3",
      "text": "Léa a demandé à l'utilisateur d'appeler le gymnase pour le créneau du jeudi et il a appelé.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-17T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "bfb70731-2d01-45c7-bef1-652f9810cb88"
      ]
    },
    {
      "id": "5d892a42-04a5-4629-b0cb-2f265a5bd7bb",
      "text": "Léa a déclaré devant le coach et l'équipe que sans l'utilisateur le club ne tiendrait pas.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-23T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "4cf5b82c-88a2-4509-95ed-9a716bef9c26"
      ]
    },
    {
      "id": "62509df7-2626-4c73-8799-62aba11a4b0f",
      "text": "Hugo n'a pas rendu la clé du local et l'utilisateur est allé la chercher chez lui.",
      "category": "sourced_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-12T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "2b447bba-7fa4-4632-b105-7eeb8bb90bcd"
      ]
    },
    {
      "id": "69f47f32-493a-4a8a-9d8a-cb955d37d13d",
      "text": "Samir a rapporté à l'utilisateur, après l'entraînement, qu'il avait l'air épuisé et qu'il ne parlait que de l'organisation.",
      "category": "reported_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-14T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "1a03cab0-bf2e-40cf-81df-276042fbb40e"
      ]
