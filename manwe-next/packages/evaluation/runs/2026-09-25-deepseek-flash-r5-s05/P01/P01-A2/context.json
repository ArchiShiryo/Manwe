  "claims": [
    {
      "id": "0d0f39e9-4a5d-4456-b396-bdb546b7153d",
      "text": "La mention « comme d'habitude » indique que ces demandes de Maya et leur exécution par l'utilisateur sont habituelles, au-delà des épisodes consignés.",
      "category": "inference",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-05T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "c4c79ec9-83ad-468c-8ba0-31c89e36a9e9"
      ]
    },
    {
      "id": "0ebe082f-05af-4ef3-bc6c-4c3e1d0b99eb",
      "text": "L'utilisateur a appelé le propriétaire.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-16T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "b3693ddd-da31-419b-97da-bf5647317058"
      ]
    },
    {
      "id": "2130ad84-148f-4ee4-98a1-281e1a9cfc1e",
      "text": "Jules est parti tout le week-end juste avant le jour du ménage prévu.",
      "category": "sourced_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-19T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "4704fa78-c8e5-4640-9dee-4c92c3b9bd25"
      ]
    },
    {
      "id": "6bbdc4db-c2bc-4072-aa09-bb872c911ae1",
      "text": "L'utilisateur a fini par faire la vaisselle de Jules, le dimanche.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-11T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "53c05e63-b134-4bdf-b69c-1fa25f269600"
      ]
    },
    {
      "id": "6ee94b17-f2ed-4e3f-8a32-3a9d83c39a84",
      "text": "L'utilisateur a relancé Maya et Jules pour se faire rembourser la facture d'électricité.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-08T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "2e2b45e5-8e74-4f9d-8bc2-c031bf411995"
      ]
    },
    {
      "id": "8dcb19bf-4029-457e-a3d5-6921f37dd73b",
      "text": "Maya a déclaré devant ses amis que sans l'utilisateur la coloc s'effondrerait.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-22T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "e31a4c81-7bd4-4aeb-8271-a10c4b2aeaba"
      ]
    },
    {
      "id": "aa31772d-8e69-4165-929d-746287650a9e",
      "text": "Maya a remercié l'utilisateur devant ses amis.",
      "category": "sourced_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-22T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "e31a4c81-7bd4-4aeb-8271-a10c4b2aeaba"
      ]
    },
    {
      "id": "ad4a412e-e32d-4ef3-8335-73a126a6a95c",
      "text": "L'utilisateur a payé la facture d'électricité de l'appartement.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-08T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "2e2b45e5-8e74-4f9d-8bc2-c031bf411995"
      ]
    },
    {
      "id": "ae934281-b34e-4b6f-81a9-174dcecac46c",
      "text": "Maya a demandé à l'utilisateur de passer commande des courses communes, et l'utilisateur l'a fait.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-05T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "c4c79ec9-83ad-468c-8ba0-31c89e36a9e9"
      ]
    },
    {
      "id": "b9446ec5-0e4d-4827-9387-ebf2dcd7bc20",
      "text": "Jules a laissé sa vaisselle toute la semaine.",
      "category": "sourced_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-11T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "53c05e63-b134-4bdf-b69c-1fa25f269600"
      ]
    },
    {
      "id": "cf915685-e8d1-4774-b2e2-38277764fb0f",
      "text": "Karim a dit à l'utilisateur qu'il avait l'air crevé et qu'il parlait tout le temps de la coloc.",
      "category": "reported_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-13T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "e0a503ba-5b5f-4eec-87e7-7cd137be5267"
      ]
    },
    {
      "id": "ecce9efd-4784-4d27-8b10-f7c18594c156",
      "text": "Maya a demandé à l'utilisateur d'appeler le propriétaire pour la fuite de la salle de bain.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-16T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "b3693ddd-da31-419b-97da-bf5647317058"
      ]
    },
    {
      "id": "ff481a95-2d85-4d8f-8209-4257087a9430",
      "text": "L'utilisateur a fait la part de ménage de Jules.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-19T20:00:00+01:00",
      "revision": 1,
