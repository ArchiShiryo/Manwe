  "claims": [
    {
      "id": "06cb584a-a990-42d8-8e82-77b174f0f8e5",
      "text": "Jules est parti tout le week-end juste avant le jour du ménage prévu, et l'utilisateur a fait sa part.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-19T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "b37be0ea-48b9-433e-8755-d3618bef0fc7"
      ]
    },
    {
      "id": "4176db4a-26db-415a-b11a-f5cfb88e4312",
      "text": "L'utilisateur a payé la facture d'électricité de l'appartement et a relancé Maya et Jules pour qu'ils le remboursent.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-08T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "e662e4c1-fa8f-47c0-8f4f-6d03d1e54f82"
      ]
    },
    {
      "id": "5c06375f-d555-47db-a7d4-9161eba8a12f",
      "text": "Karim a dit à l'utilisateur, au café, qu'il avait l'air crevé et qu'il parlait tout le temps de la coloc.",
      "category": "reported_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-13T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "2eaf6b64-5383-4696-88d0-2517dff28602"
      ]
    },
    {
      "id": "702d8374-c04e-4697-9a0f-c2708509cd9f",
      "text": "Maya a remercié l'utilisateur devant ses amis en disant que sans lui la coloc s'effondrerait.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-22T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "06ba87fd-a1fe-4671-bb37-ce0ecf08f79d"
      ]
    },
    {
      "id": "a31d92e8-ee6b-4b1f-82e2-7eb1946a9793",
      "text": "Maya a demandé à l'utilisateur de passer commande des courses communes, et il l'a fait.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-05T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "b222c478-df24-4780-8d15-753a8f10ec64"
      ]
    },
    {
      "id": "c1b0f67f-7853-42e8-a0e4-dbee2db0a27d",
      "text": "Maya a demandé à l'utilisateur d'appeler le propriétaire pour la fuite de la salle de bain, et il a appelé.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-16T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "fcabf296-c961-4694-908e-e0d41b028e86"
      ]
    },
    {
      "id": "f4196efa-de4b-426d-9c0a-4be345f2b3d5",
      "text": "Jules a laissé sa vaisselle toute la semaine et l'utilisateur a fini par la faire le dimanche.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-11T20:00:00+01:00",
      "revision": 1,
      "sourceIds": [
        "fa6d74aa-90a0-4f51-838f-9f9e73200dfc"
      ]
    }
