    {
      "id": "25ff0372-0095-4f98-aa38-435177020036",
      "question": "Quand Léa te demande quelque chose pour le club, qu'est-ce que tu ressens : le plaisir d'être celui dont on ne peut pas se passer, ou surtout l'impression de ne pas pouvoir refuser ?",
      "status": "open",
      "targets": [
        {
          "kind": "hypothesis",
