  "hypotheses": [
    {
      "id": "2e1c4e71-1331-476a-9b98-27b7cd2e3b0b",
      "statement": "Avec Maya, l'initiative est asymétrique : elle formule les demandes (courses, appeler le propriétaire), l'utilisateur exécute ; elle y gagne la délégation de la charge mentale, il y gagne l'approbation et le remerciement public.",
      "depth": "D2",
      "confidence": "moderate",
      "status": "plausible",
      "needsReview": false,
      "limits": "Trois épisodes sur dix-sept jours ; on ne sait pas si Maya prend aussi des initiatives non rapportées.",
      "revisionConditions": "Si Maya exécute spontanément une tâche ou si l'utilisateur décline une demande, la lecture s'affaiblit.",
      "validFrom": "2026-01-05",
      "rank": 1,
      "mechanism": {
        "optimizes": "pour Maya, déléguer la charge mentale ; pour l'utilisateur, l'approbation de Maya et éviter de la décevoir",
        "barrier": "l'utilisateur ne refuse jamais, donc Maya n'a aucune raison de changer",
        "prediction": "Maya continuera de passer par l'utilisateur pour les démarches et les tâches communes"
      },
