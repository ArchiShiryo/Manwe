  "claims": [
    {
      "id": "04f15e79-5f3a-409e-a52f-458f593ce480",
      "text": "Maya a demandé à l'utilisateur d'appeler le propriétaire pour la fuite de la salle de bain ; l'utilisateur a appelé.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-16",
      "revision": 1,
      "sourceIds": [
