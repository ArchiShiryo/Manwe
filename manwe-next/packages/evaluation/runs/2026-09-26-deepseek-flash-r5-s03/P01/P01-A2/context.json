      ]
    },
    {
      "id": "146e07b3-30d4-461a-bc42-434d233266f6",
      "text": "L'utilisateur a payé la facture d'électricité de l'appartement.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-08",
      "revision": 1,
      "sourceIds": [
        "207bbf6c-30d0-44c8-8f27-975914f8b98a"
      ]
    },
    {
      "id": "45b7524a-946e-4770-b026-892d0f5dfdc3",
      "text": "Jules est parti tout le week-end juste avant le jour du ménage prévu.",
      "category": "sourced_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-19",
      "revision": 1,
      "sourceIds": [
        "2ae72fac-1bcf-4521-af7f-38e10587fae6"
      ]
    },
    {
      "id": "4bf7e16a-40ad-48fa-8ad1-e40d41e07f35",
      "text": "L'utilisateur a fini par faire la vaisselle de Jules le dimanche.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-11",
      "revision": 1,
      "sourceIds": [
        "d8da6e87-76d3-47ad-a119-bc209c929e2c"
      ]
    },
    {
      "id": "50966ec4-d870-4157-97f8-31d23c307a81",
      "text": "L'utilisateur a relancé Maya et Jules pour se faire rembourser la facture d'électricité.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-08",
      "revision": 1,
      "sourceIds": [
        "207bbf6c-30d0-44c8-8f27-975914f8b98a"
      ]
    },
    {
      "id": "6176ae97-c6fe-4901-87b7-596e5047666b",
      "text": "En déclarant publiquement l'utilisateur indispensable, Maya valorise son rôle de celui qui tient la coloc plutôt que de le questionner.",
      "category": "inference",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-22",
      "revision": 1,
      "sourceIds": [
        "390b6f4d-9418-403a-a969-63c607b5fea3"
      ]
    },
    {
      "id": "68397359-bb4a-47b7-a0af-3981030356cf",
      "text": "Jules a laissé sa vaisselle toute la semaine.",
      "category": "sourced_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-11",
      "revision": 1,
      "sourceIds": [
        "d8da6e87-76d3-47ad-a119-bc209c929e2c"
      ]
    },
    {
      "id": "832b16df-db10-4f7b-afee-bc4b301336db",
      "text": "Maya a remercié l'utilisateur devant ses amis en disant que sans lui la coloc s'effondrerait.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-22",
      "revision": 1,
      "sourceIds": [
        "390b6f4d-9418-403a-a969-63c607b5fea3"
      ]
    },
    {
      "id": "97f75da8-bf53-48fc-9a14-1e3c77060c5b",
      "text": "L'utilisateur a fait la part de ménage de Jules.",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-19",
      "revision": 1,
      "sourceIds": [
        "2ae72fac-1bcf-4521-af7f-38e10587fae6"
      ]
    },
    {
      "id": "bda10278-d29d-43a2-9760-d4347ca7d476",
      "text": "Karim a dit à l'utilisateur qu'il avait l'air crevé et qu'il parlait tout le temps de la coloc.",
      "category": "reported_observation",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-13",
      "revision": 1,
      "sourceIds": [
        "86c454c4-06f8-4f92-94f0-68dd7a0b4aea"
      ]
    },
    {
      "id": "c720857d-6623-42b7-8a47-7282b000de97",
      "text": "Maya a demandé à l'utilisateur de passer commande des courses communes ; l'utilisateur l'a fait, « comme d'habitude ».",
      "category": "explicit_statement",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-05",
      "revision": 1,
      "sourceIds": [
        "b51ec131-7fc0-41f9-b3c7-451fae32d849"
      ]
    },
    {
      "id": "cbfcc845-ed99-438d-99d4-c3f8384b451f",
      "text": "« Comme d'habitude » indique que la demande de Maya et son exécution par l'utilisateur constituent une routine installée.",
      "category": "inference",
      "modality": "actual",
      "knowledgeStatus": "unresolved",
      "validFrom": "2026-01-05",
      "revision": 1,
      "sourceIds": [
        "b51ec131-7fc0-41f9-b3c7-451fae32d849"
      ]
    }
