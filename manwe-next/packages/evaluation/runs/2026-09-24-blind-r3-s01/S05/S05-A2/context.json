    {
      "id": "902c824f-4968-47b4-a148-ae1478c785cc",
      "workspaceId": "evaluation-2026-09-24-blind-r3-s01-S05",
      "statement": "Les réactions de Théo peuvent être des réponses contextuelles distinctes — curiosité, humour sarcastique, déception liée à un anniversaire ou circonstances propres à chaque épisode — sans besoin durable de réassurance ni crainte de perdre sa place.",
      "depth": "D3",
      "framework": "contextuel et relationnel",
      "construct": "réactivité situationnelle",
      "confidence": "moderate",
      "status": "draft",
      "needsReview": false,
      "reviewReason": null,
      "reviewSinceRevision": null,
      "limits": "Le paquet ne fournit pas de contexte détaillé sur l'humour habituel de Théo, les attentes autour de son anniversaire ni les circonstances précises des questions répétées.",
      "revisionConditions": "Une répétition du même schéma dans de nouveaux contextes et avec une expression explicite de crainte de remplacement affaiblirait cette explication situationnelle.",
