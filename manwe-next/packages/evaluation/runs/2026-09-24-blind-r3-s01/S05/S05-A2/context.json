    {
      "id": "850eaa14-662d-4f45-93a9-5d6be40e15fe",
      "workspaceId": "evaluation-2026-09-24-blind-r3-s01-S05",
      "statement": "Théo peut craindre de perdre une place privilégiée dans la relation avec l'utilisateur et rechercher de la réassurance quant à son importance ou à l'exclusivité relative du lien.",
      "depth": "D3",
      "framework": "attachement",
      "construct": "besoin de réassurance et sensibilité à la mise à l'écart",
      "confidence": "moderate",
      "status": "draft",
      "needsReview": false,
      "reviewReason": null,
      "reviewSinceRevision": null,
      "limits": "Aucun motif n'a été explicitement déclaré par Théo ; la peur de perdre sa place et le besoin de réassurance restent des interprétations.",
      "revisionConditions": "Des explications situationnelles indépendantes pour les trois épisodes, ou l'absence de réactions comparables dans d'autres situations de mise en concurrence relationnelle, feraient privilégier l'alternative.",
